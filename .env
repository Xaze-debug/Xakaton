# ============================================
# НАСТРОЙКИ API РОСТЕЛЕКОМ
# ============================================

# Токен доступа к ai.rt.ru (выдаёт администратор)
# Если оставить пустым — будет работать демо-режим
RT_API_TOKEN=eyJhbGciOiJIUzM4NCJ9.eyJzY29wZXMiOlsibGxhbWEiLCJzZCIsInlhQXJ0Il0sInN1YiI6ImhhY2thdGhvbl8yNl8wMSIsImlhdCI6MTc3Njk0ODk3NiwiZXhwIjoxNzc3NjQwMTc2fQ.BADD90CiTBeUKDoUbGxKAkYAKTGQW1ayW3WS_x-iC5uoeSKlZuQjUHGf5FAoF2MQ

# Базовый URL API
RT_API_BASE=https://ai.rt.ru/api/1.0

# ============================================
# НАСТРОЙКИ МОДЕЛЕЙ
# ============================================

# LLM модель для генерации текста
LLM_MODEL=Qwen/Qwen2.5-72B-Instruct

# Модель для генерации изображений
IMG_MODEL=yandex-art

# Соотношение сторон для картинок (16:9 для презентаций)
IMG_ASPECT=16:9

# ============================================
# ПАРАМЕТРЫ ГЕНЕРАЦИИ
# ============================================

# Максимальное время ожидания генерации картинки (секунды)
IMG_TIMEOUT=60

# Количество попыток проверки готовности картинки
IMG_POLL_ATTEMPTS=30